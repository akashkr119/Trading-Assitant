# Choose the broker used for market data: groww or upstox
MARKET_DATA_PROVIDER=groww
MARKET_DATA_TIMEOUT_SECONDS=10

# Groww: paste the read-only API access token here.
GROWW_ACCESS_TOKEN=

# Upstox: use an access token and comma-separated symbol mappings.
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENT_KEYS=RELIANCE=NSE_EQ|INE002A01018,TCS=NSE_EQ|INE467B01029
